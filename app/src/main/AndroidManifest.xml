<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <package android:name="com.tencent.mm" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/app_description"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar">

        <activity
            android:name=".activity.TransparentActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />

        <activity
            android:name=".activity.settings.SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <activity
            android:name=".activity.agent.WeAgentSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <activity
            android:name=".activity.automation.AutomationSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <activity
            android:name=".features.items.chat.ReadReceiptsSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <activity
            android:name=".features.items.chat.spoof.SpoofChatMessagesActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <activity
            android:name=".features.items.system.QrCodeRecordSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <activity
            android:name=".activity.settings.ExtensionsSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

        <activity
            android:name=".activity.scripting_python.PythonScriptsSettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight.NoActionBar" />

    </application>
</manifest>

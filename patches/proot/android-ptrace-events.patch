 static Tracees tracees;

+static pid_t find_untracked_child(const Tracee *parent)
+{
+	char path[64];
+	long candidate;
+	FILE *children;
+
+	snprintf(path, sizeof(path), "/proc/%d/task/%d/children", parent->pid, parent->pid);
+	children = fopen(path, "r");
+	if (children == NULL)
+		return 0;
+
+	while (fscanf(children, "%ld", &candidate) == 1) {
+		if (candidate > 0 && get_tracee(NULL, (pid_t) candidate, false) == NULL) {
+			fclose(children);
+			return (pid_t) candidate;
+		}
+	}
+	fclose(children);
+	return 0;
+}
+
+static bool read_process_ids(pid_t pid, pid_t *ppid, pid_t *tgid)
+{
+	char line[128];
+	char path[64];
+	FILE *status;
+
+	*ppid = 0;
+	*tgid = 0;
+	snprintf(path, sizeof(path), "/proc/%d/status", pid);
+	status = fopen(path, "r");
+	if (status == NULL)
+		return false;
+	while (fgets(line, sizeof(line), status) != NULL) {
+		if (sscanf(line, "PPid:%d", ppid) == 1)
+			continue;
+		(void) sscanf(line, "Tgid:%d", tgid);
+	}
+	fclose(status);
+	return *ppid > 0 && *tgid > 0;
+}
+
+static bool belongs_to_parent(const Tracee *parent, pid_t pid, word_t clone_flags)
+{
+	pid_t child_ppid, child_tgid, parent_ppid, parent_tgid;
+	pid_t expected_ppid;
+
+	if (!read_process_ids(pid, &child_ppid, &child_tgid)
+	    || !read_process_ids(parent->pid, &parent_ppid, &parent_tgid))
+		return false;
+	expected_ppid = (clone_flags & CLONE_PARENT) != 0 ? parent_ppid : parent->pid;
+	return child_ppid == expected_ppid
+		|| ((clone_flags & CLONE_THREAD) != 0 && child_tgid == parent_tgid);
+}
+
+static Tracee *find_pending_child(const Tracee *parent, word_t clone_flags)
+{
+	Tracee *candidate;
+
+	LIST_FOREACH(candidate, &tracees, link) {
+		if (candidate->exe == NULL
+		    && candidate->sigstop == SIGSTOP_PENDING
+		    && belongs_to_parent(parent, candidate->pid, clone_flags))
+			return candidate;
+	}
+	return NULL;
+}
+
+static pid_t wait_for_untracked_child(const Tracee *parent, word_t clone_flags,
+					int *status_out, bool *stop_consumed)
+{
+	for (int attempts = 0; attempts < 64; attempts++) {
+		int tracee_status;
+		pid_t pid;
+
+		pid = find_untracked_child(parent);
+		if (pid > 0) {
+			*stop_consumed = false;
+			return pid;
+		}
+		pid = waitpid(-1, &tracee_status, __WALL);
+		if (pid < 0)
+			return 0;
+		if (get_tracee(NULL, pid, false) == NULL
+		    && belongs_to_parent(parent, pid, clone_flags)) {
+			*status_out = tracee_status;
+			*stop_consumed = true;
+			return pid;
+		}
+		queue_tracee_event(pid, tracee_status);
+	}
+	return 0;
+}


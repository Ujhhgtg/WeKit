+	struct PendingTraceeEvent *next;
+} PendingTraceeEvent;
+
+static PendingTraceeEvent *pending_events_head;
+static PendingTraceeEvent *pending_events_tail;
+
+void queue_tracee_event(pid_t pid, int tracee_status)
+{
+	PendingTraceeEvent *event = malloc(sizeof(*event));
+	if (event == NULL) {
+		note(NULL, ERROR, INTERNAL, "can't queue tracee event");
+		exit(EXIT_FAILURE);
+	}
+	event->pid = pid;
+	event->status = tracee_status;
+	event->next = NULL;
+	if (pending_events_tail == NULL)
+		pending_events_head = event;
+	else
+		pending_events_tail->next = event;
+	pending_events_tail = event;
+}
+
+static bool dequeue_tracee_event(pid_t *pid, int *tracee_status)
+{
+	PendingTraceeEvent *event = pending_events_head;
+	if (event == NULL)
+		return false;
+	pending_events_head = event->next;
+	if (pending_events_head == NULL)
+		pending_events_tail = NULL;
+	*pid = event->pid;
+	*tracee_status = event->status;
+	free(event);
+	return true;
+}

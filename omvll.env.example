# Copy this file to omvll.env and replace the paths for the local O-MVLL install.
WEKIT_OMVLL_PLUGIN=/absolute/path/to/omvll-ndk.so
WEKIT_OMVLL_CONFIG=/absolute/path/to/WeKit/bootstrap/src/main/cpp/omvll_config.py
WEKIT_OMVLL_PYTHONPATH=/absolute/path/to/Python-3.10.7/Lib
WEKIT_OMVLL_NDK=/absolute/path/to/android-sdk/ndk/29.0.14206865
